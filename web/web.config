<?xml version="1.0" encoding="utf-8"?>
<!--
  Q-Portal PDFiler - modulo web (BentoPDF self-hosted, elaborazione solo nel browser)
  Cartella: <sito>\PDFiler   URL: /PDFiler/it/
  Nessun modulo IIS aggiuntivo richiesto (niente URL Rewrite): gli URL senza estensione
  sono serviti da cartelle con index.html.
-->
<configuration>
  <system.webServer>

    <defaultDocument enabled="true">
      <files>
        <remove value="index.html" />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <staticContent>
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="text/javascript" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".map" />
      <mimeMap fileExtension=".map" mimeType="application/json" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".ftl" />
      <mimeMap fileExtension=".ftl" mimeType="text/plain" />
      <remove fileExtension=".bcmap" />
      <mimeMap fileExtension=".bcmap" mimeType="application/octet-stream" />
      <remove fileExtension=".pfb" />
      <mimeMap fileExtension=".pfb" mimeType="application/octet-stream" />
      <remove fileExtension=".whl" />
      <mimeMap fileExtension=".whl" mimeType="application/octet-stream" />
      <remove fileExtension=".data" />
      <mimeMap fileExtension=".data" mimeType="application/octet-stream" />
      <remove fileExtension=".gz" />
      <mimeMap fileExtension=".gz" mimeType="application/octet-stream" />
      <remove fileExtension=".icc" />
      <mimeMap fileExtension=".icc" mimeType="application/vnd.iccprofile" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".ttf" />
      <mimeMap fileExtension=".ttf" mimeType="font/ttf" />
      <remove fileExtension=".otf" />
      <mimeMap fileExtension=".otf" mimeType="font/otf" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".md" />
      <mimeMap fileExtension=".md" mimeType="text/plain" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <remove name="Cross-Origin-Opener-Policy" />
        <add name="Cross-Origin-Opener-Policy" value="same-origin" />
        <remove name="Cross-Origin-Embedder-Policy" />
        <add name="Cross-Origin-Embedder-Policy" value="credentialless" />
        <remove name="Cross-Origin-Resource-Policy" />
        <add name="Cross-Origin-Resource-Policy" value="same-origin" />
        <remove name="Content-Security-Policy" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' blob: data:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-src 'self' blob:; frame-ancestors 'self'; form-action 'self'" />
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="same-origin" />
        <remove name="Permissions-Policy" />
        <add name="Permissions-Policy" value="geolocation=(), camera=(), microphone=(), payment=(), usb=()" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>

  <!-- LibreOffice WASM (conversioni Word/Excel/PowerPoint -> PDF): file precompressi, il browser li decomprime -->
  <location path="libreoffice-wasm/soffice.wasm.gz">
    <system.webServer>
      <urlCompression doStaticCompression="false" doDynamicCompression="false" />
      <staticContent>
        <remove fileExtension=".gz" />
        <mimeMap fileExtension=".gz" mimeType="application/wasm" />
      </staticContent>
      <httpProtocol>
        <customHeaders>
          <remove name="Content-Encoding" />
          <add name="Content-Encoding" value="gzip" />
          <remove name="Vary" />
          <add name="Vary" value="Accept-Encoding" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="libreoffice-wasm/soffice.data.gz">
    <system.webServer>
      <urlCompression doStaticCompression="false" doDynamicCompression="false" />
      <staticContent>
        <remove fileExtension=".gz" />
        <mimeMap fileExtension=".gz" mimeType="application/octet-stream" />
      </staticContent>
      <httpProtocol>
        <customHeaders>
          <remove name="Content-Encoding" />
          <add name="Content-Encoding" value="gzip" />
          <remove name="Vary" />
          <add name="Vary" value="Accept-Encoding" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
